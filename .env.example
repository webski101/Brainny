FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6380
FALKORDB_GRAPH=brainny
# FalkorDB Cloud (free tier): set host/port from Connectivity tab
# FALKORDB_USERNAME=falkordb
# FALKORDB_PASSWORD=
# Free Cloud has no TLS — leave unset. Paid tiers: FALKORDB_TLS=true
# Protects POST /api/decide (required on Vercel / production)
# BRAINNY_DECIDE_SECRET=
# Optional — without this, Brainny uses deterministic Cypher routing
# OPENAI_API_KEY=
